# =============================================================================
# SC08 - Machine Predictive Maintenance & Fault Priority System
# .gitignore
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# --- Virtual environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- Distribution / packaging ---
dist/
build/
*.egg-info/
*.egg

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/

# --- IDEs ---
.vscode/
.idea/
*.swp
*.swo
*.DS_Store
Thumbs.db

# --- Processed data (generated by preprocessing.py, not committed) ---
data/processed/*.npy
data/processed/*.npz
data/processed/norm_params.json

# --- Trained model weights (large binary files) ---
# Uncomment the line below if you do NOT want to commit weights.
# results/ann_weights.npz

# --- Training history (generated, can be re-run) ---
results/training_history.json

# --- Evaluation metrics (generated, can be re-run) ---
results/metrics.json

# --- Figures (generated, can be re-run) ---
results/figures/*.png
results/figures/*.pdf

# --- Streamlit cache ---
.streamlit/

# --- OS ---
*.log
